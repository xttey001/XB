// Prisma Schema for XB Notes
// 单用户笔记应用，SQLite 数据库

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Note {
  id          String    @id @default(cuid())
  content     String    // Markdown 正文
  images      String    // JSON 字符串，存图片路径数组（SQLite 不支持原生数组）
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        String    // JSON 字符串，存标签数组
  isFavorite  Boolean   @default(false)

  // 重要等级：important（重要）/ very_important（极重要），与标签解耦
  importance  String?

  // 置顶：各视图独立维护置顶状态
  pinnedGlobal        Boolean   @default(false)
  pinnedFavorite      Boolean   @default(false)
  pinnedImportant     Boolean   @default(false)
  pinnedVeryImportant Boolean   @default(false)
  pinnedCategory      Boolean   @default(false)
  pinnedLiked         Boolean   @default(false)
  pinnedReposted      Boolean   @default(false)

  // 置顶排序：各视图独立维护，避免跨视图互相干扰
  globalPinOrder        Int   @default(0)
  favoritePinOrder      Int   @default(0)
  importantPinOrder     Int   @default(0)
  veryImportantPinOrder Int   @default(0)
  categoryPinOrder      Int   @default(0)
  likedPinOrder         Int   @default(0)
  repostedPinOrder      Int   @default(0)

  // 自定义排序：各列表独立维护
  // - globalOrder:    "全部笔记"列表的排序
  // - favoriteOrder:  "收藏"列表内的排序
  // - importantOrder: "重要"列表内的排序
  // - categoryOrder:  所属分类内的排序（同一笔记在不同分类视角下唯一）
  globalOrder     Int   @default(0)
  favoriteOrder   Int   @default(0)
  importantOrder  Int   @default(0)
  categoryOrder   Int   @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 回顾提醒：定期回顾这条笔记
  reviewAt       DateTime?  // 下次回顾时间
  reviewRepeat   String?    // 重复频率：none / daily / weekly / biweekly / monthly / ebbinghaus
  reviewStep     Int        @default(0)  // 遗忘曲线当前步骤 (0-4)：1天→3天→7天→14天→30天
  reviewLastSent DateTime?  // 上次发送回顾提醒的时间，避免重复弹出

  // 转发：指向被转发的原笔记
  repostOfId  String?
  repostOf    Note?     @relation("NoteReposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts     Note[]    @relation("NoteReposts")

  likes       Like[]
  comments    Comment[]

  outgoingLinks   NoteLink[] @relation("NoteLinkSource")
  incomingLinks   NoteLink[] @relation("NoteLinkTarget")
  noteEntities    NoteEntity[]

  @@index([categoryId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([isFavorite])
  @@index([pinnedGlobal])
  @@index([pinnedFavorite])
  @@index([pinnedImportant])
  @@index([pinnedVeryImportant])
  @@index([pinnedCategory])
  @@index([pinnedLiked])
  @@index([pinnedReposted])
  @@index([repostOfId])
  @@index([reviewAt])
}

model Like {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([noteId])
}

model Comment {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  content   String
  images    String    @default("[]") // JSON 字符串，存图片路径数组
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
  @@index([parentId])
}

model NoteLink {
  id        String   @id @default(cuid())
  sourceId  String   // 来源笔记（谁在链接）
  targetId  String   // 目标笔记（被链接的）
  source    Note     @relation("NoteLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Note     @relation("NoteLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  // 链接来源：manual（用户手动创建）/ ai_suggested（AI 建议，待审核）/ ai_accepted（AI 建议已接受）
  linkSource String   @default("manual")
  // 链接类型：relates（普通关联）/ part_of（属于）/ example（示例）/ cause（因果）/ opposite（对立）
  linkType   String?
  // AI 建议时的置信度 0-1
  confidence Float?

  createdAt DateTime @default(now())

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
  @@index([linkSource])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6B7280")
  icon      String?
  order     Int      @default(0)  // 分类在侧边栏中的排序
  pinned    Boolean  @default(false) // 是否置顶在分类列表最前
  createdAt DateTime @default(now())
  notes     Note[]

  // 知识层级：这个 Category 属于哪个一级主干（KnowledgeArea）
  knowledgeAreaId  String?
  knowledgeArea    KnowledgeArea?   @relation(fields: [knowledgeAreaId], references: [id], onDelete: SetNull)

  // Category 自身的父子层级（可选嵌套，一般只嵌套一层）
  parentId String?
  parent   Category? @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryParent")

  // 掌握程度：unknown / aware / can_use / mastered
  progressStatus String @default("unknown")
}

// ===== Phase 3b: 知识层级（你要的主干-分支-叶子树） =====

// 一级主干：你手动定义的领域（交易技术、交易心理、宏观...）
model KnowledgeArea {
  id             String   @id @default(cuid())
  name           String   @unique
  icon           String?
  color          String   @default("#654ACB")
  description    String?
  order          Int      @default(0)
  // 学习进度标记（你真正要学的模块在这一层标记）
  progressStatus String   @default("unknown")  // unknown / aware / can_use / mastered
  createdAt      DateTime @default(now())

  categories Category[]
}

model Reminder {
  id          String   @id @default(cuid())
  title       String
  content     String?
  remindAt    DateTime
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  snoozeUntil DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([remindAt])
  @@index([isCompleted])
}

// ===== Phase 3: AI 知识抽取 =====

// 全局实体词典
model Entity {
  id          String   @id @default(cuid())
  name        String   @unique          // 规范名（canonical name）
  aliases     String   @default("[]")   // JSON，别名/同义词数组
  entityType  String?                    // 实体类型：concept（概念）/ term（术语）/ person（人物）/ event（事件）/ system（系统）/ other
  definition  String?                    // 一句话定义（AI 生成）
  noteCount   Int      @default(0)      // 被多少条笔记引用（缓存，从 NoteEntity 反查）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  noteRefs    NoteEntity[]
}

// 笔记 ↔ 实体 多对多
model NoteEntity {
  id        String   @id @default(cuid())
  noteId    String
  entityId  String
  context   String?  // 笔记中出现该实体的原文片段（用于溯源）
  createdAt DateTime @default(now())

  note    Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  entity  Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([noteId, entityId])
  @@index([entityId])
  @@index([noteId])
}

// 知识地图：自动生成的 Mermaid/markdown 思维导图
model KnowledgeMap {
  id          String   @id @default(cuid())
  title       String
  description String?
  // 覆盖范围：categoryId（按分类）/ noteIds（JSON，自定义笔记集合）
  scopeType   String   // "category" / "custom"
  scopeValue  String?  // categoryId 或 JSON noteIds
  mermaid     String   // 完整的 ```mermaid ... ``` 内容
  markdown    String?  // 可选的 markdown 版本（带说明）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scopeType])
}
